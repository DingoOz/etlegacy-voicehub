[Unit]
Description=ET: Legacy voicehub (LLM-driven spoken bots for the LAN)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/dingo/Programming/etlegacy/voicehub
ExecStart=/home/dingo/.local/bin/uv run --project /home/dingo/Programming/etlegacy/voicehub python -m voicehub
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=default.target
